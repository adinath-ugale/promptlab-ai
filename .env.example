# ============================================================
# PromptLab AI - Environment Configuration Template
# ============================================================
# Copy this file to '.env' and fill in your actual credentials:
#   copy .env.example .env   (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# NOTE: Never commit your actual '.env' file to Git!
# ============================================================

# Your Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Supported model identifier
# Recommended models:
#   - gemini-3.8-flash (Latest, fast, highly capable - recommended default)
#   - gemini-3.5-flash-lite (Fast and ultra-low latency)
#   - gemini-flash-lite-latest
GEMINI_MODEL=gemini-3.8-flash

